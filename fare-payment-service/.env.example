# Copy to .env (which is git-ignored) or export these in your terminal. Fake example values only -
# never commit real secrets.
DB_URL=jdbc:postgresql://localhost:5432/farepaymentdb
DB_USERNAME=postgres
DB_PASSWORD=change-me
SERVER_PORT=8084

# Must be IDENTICAL on Account, Driver, Ride Management and Fare & Payment (32+ characters).
RIDELINK_JWT_SECRET=change-me-shared-jwt-secret-at-least-32-chars
# Must be IDENTICAL on Ride Management, Driver and Fare & Payment. Different from the JWT secret.
RIDELINK_INTERNAL_API_KEY=change-me-shared-internal-api-key

RIDE_MANAGEMENT_BASE_URL=http://localhost:8083
RIDE_MANAGEMENT_INTEGRATION_ENABLED=true
